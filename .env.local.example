# Copia este archivo a .env.local (mismo directorio) y rellena los valores.
# .env.local NO se versiona (ver .gitignore).

# Cadena de conexión de tu cluster MongoDB Atlas.
# Incluye el nombre de la base al final, p. ej. .../open-challenge?retryWrites=true&w=majority
MONGODB_URI=

# Cadena larga y aleatoria: firma la cookie de sesión (httpOnly).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Base pública del sitio. En local déjalo así; en Vercel pon la URL del despliegue.
# Se usa para construir el enlace de recuperación de contraseña (correo, paso 6).
APP_URL=http://localhost:3000

# --- Correo (Resend) ---
# Clave de API de Resend (secreta). Sin ella no se envía nada (la app no falla).
RESEND_API_KEY=
# Remitente. El NOMBRE visible importa: el destinatario reconoce el evento.
MAIL_FROM="Open Challenge ULHN × HAROPA <open-challenge@apps.threeoclock.co>"
# Las respuestas van a la universidad, no a Three O'Clock.
MAIL_REPLY_TO=open-challenge@univ-lehavre.fr

# MODO PRUEBA: si está definida, TODOS los correos van a esta dirección, con el
# destinatario real escrito en el asunto. Evita rebotes a @univ-lehavre.fr falsos
# mientras la base tiene datos ficticios. QUITAR antes de abrir el challenge.
# MAIL_TEST_REDIRECT=carla@threeoclock.co
