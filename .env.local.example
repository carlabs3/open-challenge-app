# Copia este archivo a .env.local (mismo directorio) y rellena los valores.
# .env.local NO se versiona (ver .gitignore).

# Cadena de conexión de tu cluster MongoDB Atlas.
# Incluye el nombre de la base al final, p. ej. .../open-challenge?retryWrites=true&w=majority
MONGODB_URI=

# Cadena larga y aleatoria: firma la cookie de sesión (httpOnly).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Base pública del sitio. En local déjalo así; en Vercel pon la URL del despliegue.
# Se usa para construir el enlace de recuperación de contraseña (correo, paso 6).
APP_URL=http://localhost:3000

# --- Correo (Resend) — se usa a partir del paso 6, no hace falta para probar la auth ---
# RESEND_API_KEY=
# MAIL_FROM="Open Challenge ULHN × HAROPA <open-challenge@…>"
# MAIL_REPLY_TO=open-challenge@univ-lehavre.fr
